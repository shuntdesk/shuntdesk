{
  "manifest_version": 3,
  "name": "Shuntdesk",
  "version": "1.1.0",
  "description": "Shuntdesk's read of a Robinhood Chain token, right on its Pons and DexScreener page, and alerts for your watchlist. Read-only.",
  "homepage_url": "https://shuntdesk.com/extension/",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Shuntdesk watchlist", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "notifications"],
  "content_scripts": [
    {
      "matches": ["https://ponsfamily.com/*", "https://*.ponsfamily.com/*", "https://dexscreener.com/robinhood/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://shuntdesk.com/*", "https://api.dexscreener.com/*"]
}
